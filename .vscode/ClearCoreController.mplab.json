                    "name": "CMSIS",
                    "vendor": "ARM",
                    "version": "5.4.0"
                }
            ],
            "fileSet": "Release files",
            "toolchain": "Release-arm-gcc",
            "postBuildSteps": [
                "\"$(SolutionDir)\\..\\Tools\\uf2-builder\\Release\\uf2-builder.exe\" \"$(OutputDirectory)\\$(OutputFileName).bin\" \"$(OutputDirectory)\\$(OutputFileName).uf2\""
            ]
        },
